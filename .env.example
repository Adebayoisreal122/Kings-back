PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kings-apartment
JWT_SECRET=change-me
CLIENT_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=sk_test_xxx
# Web push (run: npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kingsapartment.com
# Image uploads (from your Cloudinary dashboard)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# SMS alerts (Termii). Without these, messages are printed to the server console instead of sent.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://api.ng.termii.com/api
NOTIFY_ADMIN_SMS=false
